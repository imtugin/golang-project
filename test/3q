package main

import (
	"fmt"
	"math/rand"
	"sync"
	"time"
)

func waiging(wg *sync.WaitGroup) int {
	defer wg.Done()
	watingSecond := rand.Intn(5 + 1)
	time.Sleep(time.Duration(watingSecond) * time.Second)
	return watingSecond
}
func main() {
	wg := &sync.WaitGroup{}
	mutex := &sync.Mutex{}
	var totalTime int
	start := time.Now()
	wg.Add(100)
	for range 100 {
		mutex.Lock()
		timeFunc := waiging(wg)
		totalTime += timeFunc
		mutex.Unlock()
	}

	wg.Wait()
	mainTime := time.Since(start)
	fmt.Println("Время выполнения всех функций:", mainTime)
	fmt.Println("Суммарное количество секунд:", totalTime)
}
